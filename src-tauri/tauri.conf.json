{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Score Explorer",
  "mainBinaryName": "score-explorer",
  "version": "0.5.0",
  "identifier": "dev.score-explorer.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Score Explorer", "width": 1440, "height": 940, "minWidth": 920, "minHeight": 640 }], "security": { "assetProtocol": { "enable": true, "scope": [] }, "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420" } },
  "bundle": { "active": false }
}
